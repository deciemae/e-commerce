}

.timeline-step-h.active .timeline-circle {
    background: #e2e8f0;
    border: 4px solid #e2e8f0;
    box-shadow: inset 0 0 0 4px #000000;
}

.timeline-step-h.cancelled .timeline-circle {
    background: #ef4444;
}

.timeline-step-h.done .timeline-circle svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
}

.timeline-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: #94a3b8;
    text-align: center;
    line-height: 1.2;
}

.timeline-step-h.done .timeline-label {
    color: #000000;
}

.timeline-step-h.active .timeline-label {
    color: #000000;
}

.timeline-step-h.cancelled .timeline-label {
    color: #ef4444;
}

.auth-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(28rem, .9fr);
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
}

.auth-visual {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: 100%;
    align-items: flex-end;
    overflow: hidden;
    color: var(--color-canvas);
    background: var(--color-ink);
}

.auth-visual-image,
.auth-visual-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
}

.auth-visual-image {
    z-index: -2;
    object-fit: cover;
}

.auth-visual-overlay {
    z-index: -1;
    background: linear-gradient(0deg, rgba(0, 0, 0, .8), rgba(0, 0, 0, .08) 72%);
}

.auth-visual-content {
    width: min(100%, 44rem);
    padding: clamp(2rem, 6vw, 5rem);
}

.auth-visual-eyebrow,
.auth-kicker {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
}

.auth-visual-content h2 {
    max-width: 13ch;
    margin: 0;
    color: inherit;
    font-size: clamp(2.25rem, 4.2vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -.045em;
    line-height: 1.03;
}

.auth-visual-content > p:last-child {
    max-width: 34rem;
    margin: var(--space-4) 0 0;
    color: rgba(255, 255, 255, .84);
    font-size: 1rem;
    line-height: 1.6;
}

.auth-panel {
    display: grid;
    padding: clamp(2rem, 5vw, 5rem);
    background: var(--color-canvas);
    place-items: center;
}

.auth-card {
    width: min(100%, 30rem);
    padding: 0;
    background: var(--color-canvas);
    border: 0;
    border-radius: var(--radius-none);
    box-shadow: none;
}

.auth-card-wide {
    width: min(100%, 38rem);
}

.auth-brand-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: clamp(2rem, 5vw, 4rem);
}

.auth-brand,
.auth-back-link,
.auth-switch a {
    color: var(--color-ink);
    text-decoration: none;
}

.auth-brand {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -.03em;
}

.auth-back-link {
    min-height: 44px;
    padding: .75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: .8125rem;
    font-weight: 600;
}

.auth-back-link:hover {
    color: var(--color-canvas);
    background: var(--color-ink);
    border-color: var(--color-ink);
}

.auth-kicker {
    color: var(--color-text-muted);
}

.auth-card h1 {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -.045em;
    line-height: 1.05;
}

.auth-intro {
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
    line-height: 1.6;
}

.auth-alert {
    margin: var(--space-6) 0 0;
    border-radius: var(--radius-sm);
}

.auth-form {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-8);
}

.auth-field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
}

.auth-form .form-label {
    margin-bottom: var(--space-2);
    color: var(--color-ink);
    font-size: .875rem;
    font-weight: 600;
}

.auth-form .form-label span {
    color: var(--color-text-muted);
    font-weight: 400;
}

.auth-form .form-control {
    min-height: 52px;
    padding: .75rem 1rem;
    color: var(--color-ink);
    background: var(--color-surface);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
}

.auth-form .form-control:hover {
    border-color: var(--color-border);
}

.auth-form .form-control:focus {
    background: var(--color-canvas);
    border-color: var(--color-ink);
    box-shadow: var(--focus-ring);
}

.auth-field-hint {
    margin: calc(var(--space-2) * -1) 0 0;
    color: var(--color-text-muted);
    font-size: .75rem;
    line-height: 1.5;
}

.auth-submit {
    min-height: 52px;
    margin-top: var(--space-2);
    padding: .75rem 1.5rem;
    color: var(--color-canvas);
    background: var(--color-ink);
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-pill);
    font-weight: 700;
}

.auth-submit:hover {
    background: var(--color-text-soft);
}

.auth-switch {
    margin: var(--space-6) 0 0;
    color: var(--color-text-muted);
    font-size: .875rem;
    text-align: center;
}

.auth-switch a {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: .2rem;
}

.form-muted {
    font-size: .85rem;
    color: #64748b;
}

@media (max-width: 899.98px) {
    .auth-layout {
        grid-template-columns: 1fr;
    }

    .auth-visual {
        min-height: 20rem;
    }

    .auth-visual-content {
        padding: var(--space-8) clamp(1.5rem, 6vw, 4rem);
    }

    .auth-visual-content h2 {
        max-width: 16ch;
        font-size: clamp(2.25rem, 7vw, 3.5rem);
    }

    .auth-panel {
        padding: clamp(2rem, 8vw, 4rem) clamp(1rem, 6vw, 4rem);
    }
}

@media (max-width: 599.98px) {
    .auth-visual {
        min-height: 15rem;
    }

    .auth-visual-content {
        padding: var(--space-6) var(--space-4);
    }

    .auth-visual-content h2 {
        font-size: clamp(2rem, 10vw, 2.75rem);
    }

    .auth-visual-content > p:last-child {
        margin-top: var(--space-3);
        font-size: .875rem;
    }

    .auth-panel {
        padding: var(--space-8) var(--space-4);
    }

    .auth-brand-row {
        margin-bottom: var(--space-8);
    }

    .auth-card h1 {
        font-size: 2.25rem;
    }

    .auth-field-grid {
        grid-template-columns: 1fr;
    }
}


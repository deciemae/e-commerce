    min-height: 3rem;
    padding: .6rem;
    text-align: center;
    background: var(--color-canvas);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
}

.pdp-add-button {
    align-self: end;
    min-height: 3rem;
    margin: 0;
    padding: .7rem 1.5rem;
    color: var(--color-canvas);
    background: var(--color-ink);
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-pill);
    box-shadow: none;
    font-size: .9rem;
    font-weight: 600;
}

.pdp-add-button:hover:not(:disabled) {
    opacity: .84;
    box-shadow: none;
    transform: none;
}

.pdp-add-button:disabled {
    color: var(--color-text-muted);
    background: var(--color-surface);
    border-color: var(--color-surface);
}

.pdp-reviews {
    margin-top: clamp(3rem, 6vw, 6rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-border-soft);
}

.pdp-section-heading {
    margin-bottom: 1.5rem;
}

.pdp-section-heading h2 {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -.04em;
}

.pdp-section-heading h2 span {
    color: var(--color-text-muted);
    font-weight: 500;
}

.product-detail-page .pdp-review-panel {
    border: 0;
    border-top: 1px solid var(--color-border);
    border-radius: 0;
    box-shadow: none;
}

.product-detail-page .pdp-review-panel .card-header-custom {
    padding: 1.5rem 0 1rem;
    color: var(--color-ink);
    background: transparent;
    border: 0;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
}

.product-detail-page .pdp-review-panel .card-body {
    padding: 0 !important;
}

.pdp-review-form .form-label {
    color: var(--color-ink);
    font-size: .85rem;
    font-weight: 600;
}

.pdp-review-form textarea {
    min-height: 9rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    resize: vertical;
}

.pdp-review-submit {
    min-height: 3rem;
    padding: .7rem 1.5rem;
    color: var(--color-canvas);
    background: var(--color-ink);
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-pill);
    font-weight: 600;
}

.product-detail-page .star-input-group {
    gap: .1rem;
}

.product-detail-page .star-input-group input {
    position: absolute;
    display: block;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
}

.product-detail-page .star-input-group label {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    margin: 0;
    color: var(--color-border);
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    place-items: center;
    transform: none;
}

.product-detail-page .star-input-group input:focus-visible + label {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
}

.product-detail-page .star-input-group input:checked ~ label,
.product-detail-page .star-input-group label:hover,
.product-detail-page .star-input-group label:hover ~ label {
    color: var(--color-ink);
}

.product-detail-page .review-list {
    gap: 0;
}

.product-detail-page .review-item {
    padding: 1.25rem 0;
    background: var(--color-canvas);
    border: 0;
    border-bottom: 1px solid var(--color-border-soft);
    border-radius: 0;
}

.product-detail-page .review-text {
    color: var(--color-text-soft);
    font-size: .9rem;
    line-height: 1.65;
}

.product-detail-page .alert {
    border: 1px solid currentColor;
    border-radius: 0;
}

@media (max-width: 991.98px) {
    .product-detail-page .product-detail-layout {
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    .product-detail-image-stage {
        aspect-ratio: 1 / 1;
    }

    .product-detail-summary-inner {
        position: static;
        padding-top: 0;
    }
}

@media (max-width: 599.98px) {
    .product-detail-page .page-content {
        padding: 1rem;
    }

    .product-detail-page .product-detail-title {
        font-size: 2rem;
    }

    .product-detail-page .product-detail-rating {
        align-items: flex-start;
        flex-direction: column;
        gap: .35rem;
    }

    .pdp-purchase-controls {
        grid-template-columns: 1fr;
    }

    .pdp-add-button {
        width: 100%;
    }

    .product-detail-page .color-picker-wrap {
        align-items: flex-start;
        flex-direction: column;
    }
}

/* Storefront: about page */
body.customer-ui.about-page {
    overflow-x: clip;
    color: var(--color-text-soft);
    background: var(--color-canvas);
}

.about-page #main-content {
    padding-top: var(--customer-nav-space);
}

.about-hero {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(24rem, 1.05fr);
    min-height: min(46rem, calc(100svh - var(--customer-nav-space)));
    color: var(--color-canvas);
    background: var(--color-ink);
}

.about-hero-copy {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    flex-direction: column;
    padding: clamp(3rem, 7vw, 7rem);
}

.about-eyebrow {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-display);
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .16em;
    line-height: 1.4;
    text-transform: uppercase;
}

.about-hero .about-eyebrow {
    color: var(--color-border);
}

.about-hero h1 {
    max-width: 12ch;
    margin: 0;
    color: inherit;
    font-size: clamp(3rem, 5.6vw, 6rem);
    font-weight: 700;
    letter-spacing: -.055em;
    line-height: .98;
    text-wrap: balance;
}

.about-hero-intro {
    max-width: 38rem;
    margin: var(--space-6) 0 0;
    color: var(--color-border-soft);
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.7;
}

.about-primary-action {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    margin-top: var(--space-8);
    padding: .75rem 1.75rem;
    color: var(--color-ink);
    background: var(--color-canvas);
    border: 1px solid var(--color-canvas);
    border-radius: var(--radius-pill);
    font-weight: 700;
    text-decoration: none;
}

.about-primary-action:hover {
    color: var(--color-canvas);
    background: transparent;
}

.about-hero-media {
    min-width: 0;
    min-height: 30rem;
    margin: 0;
    overflow: hidden;
    background: var(--color-surface);
}

.about-hero-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
}

.about-section,
.about-facts {
    width: min(calc(100% - 2rem), 86rem);
    margin-inline: auto;
}

.about-section {
    padding-block: clamp(4rem, 8vw, 8rem);
}

.about-story {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(3rem, 8vw, 8rem);
}

.about-section h2 {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 700;
    letter-spacing: -.045em;
    line-height: 1.05;
    text-wrap: balance;
}

.about-story-copy {
    align-self: end;
}

.about-story-copy p,
.about-purpose-panel > p:last-child {
    margin: 0;
    color: var(--color-text-soft);
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    line-height: 1.8;
}

.about-story-copy p + p {
    margin-top: var(--space-6);
}

.about-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--color-border-soft);
    border-bottom: 1px solid var(--color-border-soft);
}

.about-fact {
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-right: 1px solid var(--color-border-soft);
}

.about-fact:last-child {
    border-right: 0;
}

.about-fact span,
.about-contact-list span {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.about-fact strong {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.8vw, 1.35rem);
    font-weight: 700;
    overflow-wrap: anywhere;
}

.about-purpose {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
}

.about-purpose-panel,
.about-offer-panel {
    min-width: 0;
    padding: clamp(2rem, 5vw, 5rem);
}

.about-purpose-panel {
    color: var(--color-canvas);
    background: var(--color-ink);
}

.about-purpose-panel .about-eyebrow {
    color: var(--color-border);
}

.about-purpose-panel h2 {
    color: inherit;
}

.about-purpose-panel > p:last-child {
    margin-top: var(--space-6);
    color: var(--color-border-soft);
}

.about-offer-panel {
    background: var(--color-surface);
}

.about-offer-list {
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
}

.about-offer-list li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-4) 0;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-border);
    font-weight: 600;
}

.about-offer-list li:first-child {
    border-top: 1px solid var(--color-border);
}

.about-offer-list span {
    color: var(--color-text-muted);
    font-size: .75rem;
    letter-spacing: .08em;
}

.about-contact {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    gap: clamp(3rem, 8vw, 8rem);
    border-top: 1px solid var(--color-border-soft);
}

.about-contact-list {
    display: grid;
}

.about-contact-list > div {
    min-width: 0;
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-border-soft);
}

.about-contact-list > div:first-child {
    padding-top: 0;
}

.about-contact-list a,
.about-contact-list address {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.8vw, 1.35rem);
    font-style: normal;
    font-weight: 600;
    overflow-wrap: anywhere;
    text-decoration: none;
}

.about-contact-list a:hover {
    text-decoration: underline;
    text-underline-offset: .2em;
}

.about-page .page-footer {
    border-top: 1px solid var(--color-border-soft);
    background: var(--color-canvas);
}

@media (max-width: 991.98px) {
    .about-hero {
        grid-template-columns: 1fr;
    }

    .about-hero-copy {
        min-height: 34rem;
    }

    .about-hero-media {
        min-height: 26rem;
    }

    .about-story,
    .about-contact {
        grid-template-columns: 1fr;
        gap: var(--space-8);
    }
}

@media (max-width: 767.98px) {
    .about-hero h1 {
        font-size: clamp(2.75rem, 13vw, 4.5rem);
    }

    .about-facts,
    .about-purpose {
        grid-template-columns: 1fr;
    }

    .about-fact {
        border-right: 0;
        border-bottom: 1px solid var(--color-border-soft);
    }

    .about-fact:last-child {
        border-bottom: 0;
    }
}

@media (max-width: 599.98px) {
    .about-hero-copy {
        min-height: 30rem;
        padding: var(--space-8) var(--space-4);
    }

    .about-hero-media {
        min-height: 20rem;
    }

    .about-section,
    .about-facts {
        width: min(calc(100% - 2rem), 86rem);
    }

    .about-section {
        padding-block: var(--space-8);
    }

    .about-purpose-panel,
    .about-offer-panel {
        padding: var(--space-8) var(--space-4);
    }
}

    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
}

.status-pending {
    background: #fef3c7;
    color: #92400e;
}

.status-confirmed {
    background: #dbeafe;
    color: #1d4ed8;
}

.status-processing {
    background: #ede9fe;
    color: #6d28d9;
}

.status-shipped {
    background: #cffafe;
